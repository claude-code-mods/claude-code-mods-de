{
  "name": "codex-attachment-manager",
  "displayName": "Context Attachment Manager",
  "version": "0.11.5",
  "description": "Für Claude-Code-Sitzungen mit vielen Bildern: Frühere Bilder werden als kurze Platzhalter gesendet, statt bei jeder Nachricht erneut übertragen zu werden; das Modell holt das Original per ID zurück (auch nach der Komprimierung), und der Prompt-Cache bleibt erhalten.",
  "author": {
    "name": "chipfighter"
  },
  "homepage": "https://github.com/chipfighter/context-attachment-manager",
  "repository": "https://github.com/chipfighter/context-attachment-manager",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "images",
    "multimodal",
    "context",
    "context-management",
    "attachments",
    "prompt-caching",
    "proxy"
  ],
  "mcpServers": {
    "codex_attachment_manager": {
      "command": "${CLAUDE_PLUGIN_ROOT}/plugin/scripts/launch",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/plugin/src/plugin-server.ts"
      ],
      "env": {
        "CAM_HOST": "claude"
      }
    }
  },
  "types": "./hooks/types.d.ts"
}
